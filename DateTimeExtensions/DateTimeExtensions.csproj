<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net9.0</TargetFrameworks>
		<AssemblyName>DateTimeExtensions</AssemblyName>
		<RootNamespace>DateTimeExtensions</RootNamespace>
		<!-- AssemblyVersion and FileVersion are derived from Version -->
		<Version>1.20.0</Version>
	</PropertyGroup>

	<!-- Package metadata -->
	<PropertyGroup>
		<PackageId>budul.DateTimeExtensions</PackageId>
		<Authors>budul</Authors>
		<Copyright>Copyright (c) budul</Copyright>
		<Description>Extension methods for parsing, generating and transforming date and time data: date lists and periods from strings, day bitmasks, moving dates into periods and tolerant time parsing.</Description>
		<PackageTags>datetime;timespan;date;time;parsing;bitmask;period;calendar</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/budul100/DateTimeExtensions</PackageProjectUrl>
		<PackageReleaseNotes>https://github.com/budul100/DateTimeExtensions/releases</PackageReleaseNotes>
		<RepositoryUrl>https://github.com/budul100/DateTimeExtensions</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<!-- Source Link and symbols (Source Link is built into the .NET 8+ SDK) -->
	<PropertyGroup>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<!-- Deterministic paths for CI builds -->
	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<!-- No package by default -->
	<PropertyGroup>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	</PropertyGroup>

	<!-- Package for release only -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<!-- Files from the repository root, shown on nuget.org and shipped with the package -->
	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

</Project>